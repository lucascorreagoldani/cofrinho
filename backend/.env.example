# =============================================================================
# COFRINHO API - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# =============================================================================
# BANCO DE DADOS POSTGRESQL
# =============================================================================
# POSTGRES PORTA ALTERADA NO HOST VPS: 5433 (Default é 5432)
# Motivo: Evitar conflito com a instância PostgreSQL do KowaMC na VPS (porta 5432).
# - Conexão dentro do Docker Compose (rede interna):
#   DATABASE_URL=postgresql://cofrinho:cofrinho_secret@postgres:5432/cofrinho_db
# - Conexão direta via Host (porta exposta 5433):
#   DATABASE_URL=postgresql://cofrinho:cofrinho_secret@localhost:5433/cofrinho_db
DATABASE_URL=postgresql://cofrinho:cofrinho_secret@localhost:5432/cofrinho_db
POSTGRES_USER=cofrinho
POSTGRES_PASSWORD=cofrinho_secret
POSTGRES_DB=cofrinho_db

# =============================================================================
# CACHE & SESSÕES REDIS
# =============================================================================
# REDIS PORTA ALTERADA NO HOST VPS: 6380 (Default é 6379)
# Motivo: Evitar incompatibilidade/conflito com o Redis existente do KowaMC
# que já roda na porta 6379 na VPS (db_redis, password redis@root).
# - Conexão dentro do Docker Compose (rede interna):
#   REDIS_URL=redis://redis:6379
# - Conexão direta via Host (porta exposta 6380):
#   REDIS_URL=redis://localhost:6380
REDIS_URL=redis://localhost:6379

# =============================================================================
# JWT & SEGURANÇA DE SESSÃO
# =============================================================================
JWT_SECRET=super_secret_jwt_key_cofrinho_at_least_32_characters_long_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
